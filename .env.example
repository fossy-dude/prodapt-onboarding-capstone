# =============================================================================
# SBOAI Capstone — environment template.
# Copy to `docker/.env` and fill in real values: cp .env.example docker/.env
# `docker/.env` is gitignored; NEVER commit real secrets. Placeholder values below are
# NOT secrets. This file is a temporary setup template; the service folder will have
# its own `.env` with real configuration. Cross-referenced against:
#   - docker/postgres/init/02_roles.sh + 03_databases.sql  (Postgres roles)
#   - docker/docker-compose-dependencies.yaml              (infra services)
#   - architecture.md §1.11.1 (Settings) + §1.12.4 (Postgres init)
#   - Story 1.4 (pydantic-settings), Story 1.5 (LangFuse), Story 1.6 (PII encrypt)
# =============================================================================

# ── Postgres role passwords ───────────────────────────────────────────────────
# REQUIRED — no safe defaults. Consumed by docker/postgres/init (role creation),
# the compose Flyway sidecar, and the application DATABASE_URL.
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser
POSTGRES_APP_PASSWORD=change_me_app            # role: sboai_app   (read/write app data)
POSTGRES_READONLY_PASSWORD=change_me_readonly  # role: sboai_readonly
POSTGRES_FLYWAY_PASSWORD=change_me_flyway      # role: sboai_flyway (migration owner)

# ── Application settings (pydantic-settings — Story 1.4) ─────────────────────
# CANONICAL: Use the DB__* variables below. The DATABASE_URL above is deprecated.
# env_nested_delimiter="__" => DB__HOST maps to settings.db.host.
DB__HOST=localhost
DB__PORT=5432
DB__NAME=sboai
DB__USER=sboai_app
DB__PASSWORD=change_me_app

# ── Cache / streaming ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
VALKEY_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM (Azure OpenAI) ────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Observability: LangFuse (Story 1.5) ──────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ── PII encryption key (Story 1.6 — TRAI CAF / PII at rest) ──────────────────
# 32-byte hex key (e.g. `openssl rand -hex 32`). Required before Story 1.6 ships.
ENCRYPTION_KEY=

# ── OpenTelemetry (defaults; exported to the OTEL collector) ──────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=service_webapp

# =============================================================================
# Infrastructure service configuration (docker-compose-dependencies.yaml).
# All keys below have compose defaults; override only to customise the stack.
# =============================================================================

# ── LangFuse web app (compose) ───────────────────────────────────────────────
NEXTAUTH_SECRET=dev_secret_change_me_32chars_min
NEXTAUTH_URL=http://localhost:3000
LANGFUSE_SALT=dev_salt_change_me
LANGFUSE_DB_PASSWORD=password

# ── LangFuse bootstrap org/project/user (compose defaults) ───────────────────
LANGFUSE_INIT_ORG_ID=dev-org
LANGFUSE_INIT_ORG_NAME=Dev Organization
LANGFUSE_INIT_PROJECT_ID=dev-project
LANGFUSE_INIT_PROJECT_NAME=Dev Project
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change_me_pk_dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=change_me_sk_dev
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change_me_langfuse_admin
LANGFUSE_INIT_PROJECT_RETENTION=30

# ── MiniStack (local S3 for LangFuse batch/event/media uploads) ──────────────
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=change_me_ministack
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change_me_ministack_secret
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-batch-exports
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=change_me_ministack
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=change_me_ministack_secret
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=change_me_ministack
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change_me_ministack_secret
