# Copy to docker/.env and fill in real values. NEVER commit real secrets.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_SUPERUSER_PASSWORD=change_me
POSTGRES_APP_PASSWORD=change_me
POSTGRES_READONLY_PASSWORD=change_me

# Flyway
POSTGRES_FLYWAY_USERNAME=sboai_flyway
POSTGRES_FLYWAY_PASSWORD=change_me

# Langfuse web/app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_32chars_min
SALT=change_me
ENCRYPTION_KEY=change_me_64hex_chars

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change_me
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me

# Langfuse S3 event uploads
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change_me
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

# Langfuse S3 media uploads
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change_me
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true

# Redis/Valkey
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_AUTH=

# Langfuse initial org and project
LANGFUSE_INIT_ORG_ID=change_me
LANGFUSE_INIT_ORG_NAME=change_me
LANGFUSE_INIT_PROJECT_ID=change_me
LANGFUSE_INIT_PROJECT_NAME=change_me
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change_me_pk
LANGFUSE_INIT_PROJECT_SECRET_KEY=change_me_sk
LANGFUSE_INIT_PROJECT_RETENTION=30

# Langfuse client settings for app containers. Use service DNS in Docker.
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=change_me_pk
LANGFUSE_SECRET_KEY=change_me_sk

# Langfuse initial admin user
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
LANGFUSE_INIT_USER_NAME=change_me
LANGFUSE_INIT_USER_PASSWORD=change_me
