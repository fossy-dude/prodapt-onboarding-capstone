    # Backend API Base URL (must include /api/v1 prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket Base URL (for trace and notification WebSocket connections)
VITE_WS_BASE_URL=ws://localhost:8000

# Dev mode: allow unauthenticated access to the Notification Portal
# (matches NOTIFICATION_PORTAL_OPEN_IN_DEV on the backend)
VITE_NOTIFICATION_PORTAL_OPEN_IN_DEV=true
