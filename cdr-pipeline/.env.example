# Copy to cdr-pipeline/.env and fill in values matching your local stack.
# NEVER commit real secrets — cdr-pipeline/.env is gitignored.

# Postgres. The eager `settings = Settings()` (core/config.py) fails fast if any
# required var is missing. For the local docker stack, DB__PASSWORD must equal
# docker/.env's POSTGRES_APP_PASSWORD and DB__USER must be the app role.
DB__HOST=localhost
DB__PORT=5432
DB__NAME=sboai
DB__USER=sboai_app
DB__PASSWORD=change_me_app

# Valkey (write buffer / OTP / USSD sessions).
VALKEY_URL=redis://localhost:6379

# Redpanda (Kafka wire-compatible). OUTSIDE listener is localhost:9092.
KAFKA_BROKERS=localhost:9092

# Optional consumer identity / observability (defaults shown).
KAFKA_CONSUMER_GROUP=cdr-pipeline
OTEL_SERVICE_NAME=cdr-pipeline
