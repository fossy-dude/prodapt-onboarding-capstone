# ── Application settings (pydantic-settings — Story 1.4) ─────────────────────
# CANONICAL: Use the DB__* variables below. The DATABASE_URL above is deprecated.
# env_nested_delimiter="__" => DB__HOST maps to settings.db.host.
DB__HOST=localhost
DB__PORT=5432
DB__NAME=sboai
DB__USER=sboai_app
DB__PASSWORD=change_me_app

# ── Cache / streaming ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
VALKEY_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LLM (Azure OpenAI) ────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Observability: LangFuse (Story 1.5) ──────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# ── PII encryption key (Story 1.6 — TRAI CAF / PII at rest) ──────────────────
# 32-byte hex key (e.g. `openssl rand -hex 32`). Required before Story 1.6 ships.
# Application-layer AES-256 for PII consumed/shared outside the DB (NOT at-rest
# column encryption — per user decision 2026-06-20).
ENCRYPTION_KEY=

# ── AWS Cognito via MiniStack/LocalStack (Story 1.6/1.8) ──────────────────────
# MiniStack (LocalStack-compatible) emulates Cognito; infra is provisioned by the
# docker compose stack. The app routes at this endpoint and self-provisions the
# user pool/client. LocalStack accepts dummy credentials.
COGNITO_ENDPOINT_URL=http://localhost:4566
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_NAME=sboai-subscribers
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── OpenTelemetry (defaults; exported to the OTEL collector) ──────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=service_webapp