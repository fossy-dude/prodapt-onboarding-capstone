# AWS Config
#Maps to port defined for ministack in docker-compose-dependencies.yaml
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

## Cognito
COGNITO_USER_POOL_NAME=sboai-subscribers
COGNITO_USER_POOL_ID=upid
COGNITO_CLIENT_ID=clientid
# Static password used when auto-provisioning seed subscribers on first phone-number login.
COGNITO_PHONE_USER_DEFAULT_PASSWORD=SboAI-Phone-Default-1!

# ── Azure OpenAI (Story 2.7) — override with real values ────────────────────
AZURE_OPENAI_API_KEY=dummy-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://dummy-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Azure OpenAI deployment names (Story 5.2) — set to YOUR portal deployment names.
# chat_deployment_mini: cheaper deployment used by the LLM-as-Judge eval (gpt-4o-mini-class).
# chat_deployment:      primary deployment for the support agent graph (Story 5.4).
CHAT_DEPLOYMENT_MINI=gpt-4o-mini
CHAT_DEPLOYMENT=gpt-4o

# ── Milvus Lite (Story 2.7) ──────────────────────────────────────────────────
MILVUS_DB_URI=/app/data/milvus/sboai.db

# ── Step-up OTP (Story 1.8) — mid-session second-factor (§1.7.3) ──────────────
# TTL seconds for the otp:{msisdn} Valkey key (default 300 = 5 minutes).
OTP_STEP_UP_TTL_SECONDS=300

# ── OpenTelemetry (defaults; exported to the OTEL collector) ──────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=service_webapp

LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=lf_sk_**
LANGFUSE_PUBLIC_KEY=lf_pk_**
LANGFUSE_BASE_URL=http://localhost:3000